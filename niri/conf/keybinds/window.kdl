binds {
    // FOCUS
    Mod+J               { focus-window-or-workspace-down; }
    Mod+K               { focus-window-or-workspace-up; }
    Mod+H               { focus-column-left; }
    Mod+L               { focus-column-right; }
    Mod+Down            { focus-window-or-workspace-down; }
    Mod+Up              { focus-window-or-workspace-up; }
    Mod+Left            { focus-column-left; }
    Mod+Right           { focus-column-right; }
    Mod+WheelScrollUp   cooldown-ms=180 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=180 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp             { focus-column-left; }
    Mod+Shift+WheelScrollDown           { focus-column-right; }

    // MOVE WINDOW
    Mod+Ctrl+Down       { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Up         { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Left       { move-column-left; }
    Mod+Ctrl+Right      { move-column-right; }
    Alt+Shift+J         { move-window-down-or-to-workspace-down; }
    Alt+Shift+K         { move-window-up-or-to-workspace-up; }
    Alt+Shift+H         { move-column-left; }
    Alt+Shift+L         { move-column-right; }
    Mod+Ctrl+WheelScrollUp             { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown           { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp       { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown     { move-column-right; }

    // MOVE WINDOW WITHOUT FOLLOWING IT
    Mod+Shift+1 { move-window-to-workspace 1 focus=false; }
    Mod+Shift+2 { move-window-to-workspace 2 focus=false; }
    Mod+Shift+3 { move-window-to-workspace 3 focus=false; }
    Mod+Shift+4 { move-window-to-workspace 4 focus=false; }
    Mod+Shift+5 { move-window-to-workspace 5 focus=false; }
    Mod+Shift+6 { move-window-to-workspace 6 focus=false; }
    Mod+Shift+J { move-window-to-workspace-down focus=false; }
    Mod+Shift+K { move-window-to-workspace-up focus=false; }

    // MOVE WINDOW AND FOLLOW IT
    Alt+Shift+1 { move-window-to-workspace 1; }
    Alt+Shift+2 { move-window-to-workspace 2; }
    Alt+Shift+3 { move-window-to-workspace 3; }
    Alt+Shift+4 { move-window-to-workspace 4; }
    Alt+Shift+5 { move-window-to-workspace 5; }
    Alt+Shift+6 { move-window-to-workspace 6; }

    // JUMP TO WORKSPACE
    Mod+1       { focus-workspace 1; }
    Mod+2       { focus-workspace 2; }
    Mod+3       { focus-workspace 3; }
    Mod+4       { focus-workspace 4; }
    Mod+5       { focus-workspace 5; }
    Mod+6       { focus-workspace 6; }
    Mod+Alt+J   { focus-workspace 1; }
    Mod+Alt+K   { focus-workspace 2; }
    Mod+Alt+L   { focus-workspace 3; }
    Mod+Alt+U   { focus-workspace 4; }
    Mod+Alt+I   { focus-workspace 5; }
    Mod+Alt+O   { focus-workspace 6; }

    // JUMP FOCUS
    Mod+Home        { focus-column-first; }
    Mod+End         { focus-column-last; }
    Mod+Ctrl+Home   { move-column-to-first; }
    Mod+Ctrl+End    { move-column-to-last; }

    // CONSUME / EXPEL
    Mod+BracketLeft     { consume-or-expel-window-left; }
    Mod+BracketRight    { consume-or-expel-window-right; }
    Mod+Comma           { consume-window-into-column; }
    Mod+Period          { expel-window-from-column; }

    // COLUMN / WINDOW SIZE
    Mod+R               { switch-preset-column-width; }
    Mod+Shift+R         { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R    { switch-preset-window-height; }
    Mod+Ctrl+R          { reset-window-height; }
    Mod+Minus           { set-column-width "-5%"; }
    Mod+Equal           { set-column-width "+10%"; }
    Mod+Shift+Minus     { set-window-height "-5%"; }
    Mod+Shift+Equal     { set-window-height "+10%"; }

    // FULLSCREEN
    Mod+F               { maximize-column; }
    Mod+Shift+F         { fullscreen-window; }
    Mod+M               { maximize-window-to-edges; }

    // CONTROL ZONE
    Mod+Q               { close-window; }
    Mod+Shift+Space     { toggle-window-floating; }
    Mod+Shift+Alt+Space { switch-focus-between-floating-and-tiling; }
    Alt+Tab repeat=false{ toggle-overview; }
    Mod+Backslash       { center-visible-columns; }
    Mod+Alt+W           { toggle-column-tabbed-display; }
}
