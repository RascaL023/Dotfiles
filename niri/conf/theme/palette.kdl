// ############################################################################
// ## Palette niri — satu-satunya file yang boleh berisi nilai warna.        ##
// ############################################################################
//
// Geometri (lebar border, softness/spread/offset shadow, gap) ada di
// conf/layouts/layout.kdl. File ini hanya warna, supaya nanti bisa diganti
// utuh oleh hasil matugen tanpa menyentuh config tangan.
//
// Integrasi matugen nanti:
//   1. render template ke ~/.myenv/theme/palette/current/niri/palette.kdl
//   2. di config.kdl, ganti include "conf/theme/palette.kdl" dengan
//      include optional=true "~/.myenv/theme/palette/current/niri/palette.kdl"
//   3. hapus file ini
// Bentuk blok di bawah sengaja mengikuti template agar penggantian 1:1.

layout {
    background-color "transparent"

    border {
        active-gradient from="#8ba4b0" to="#a292a3" angle=45 in="oklch"
        inactive-color "#0d0c0cee"
        urgent-color "#c4746e"
    }

    shadow {
        // effect.shadow; alpha dipisah dari hue agar tema terang tidak
        // menghasilkan bayangan yang lebih pekat dari tema gelap.
        color "#0d0c0c80"
        inactive-color "#0d0c0c4d"
    }

    insert-hint {
        color "#8ba4b080"
    }
}

overview {
    // Alpha diabaikan niri untuk backdrop overview; tulis warna solid.
    backdrop-color "#0d0c0c"
}
