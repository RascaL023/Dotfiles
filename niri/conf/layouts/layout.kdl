// Documentation: https://niri-wm.github.io/niri/Configuration:-Layout

layout {
    background-color "transparent"

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Border dari feel; focus ring dimatikan agar tidak dobel.
    focus-ring {
        off
    }
}
