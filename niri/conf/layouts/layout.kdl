// Settings that influence how windows are positioned and sized.
// Documentation: https://niri-wm.github.io/niri/Configuration:-Layout
//
// File ini sengaja tidak menyimpan warna sama sekali. Semua warna border,
// shadow, background, dan insert-hint ada di conf/theme/palette.kdl.

layout {
    gaps 8

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // preset-window-heights { }

    default-column-width { proportion 0.5; }

    // Border dipakai sebagai indikator fokus; focus ring dimatikan agar
    // tidak ada dua garis yang saling menimpa.
    focus-ring {
        off
    }

    border {
        on
        width 3
    }

    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=4
    }

    // Indikator kolom tabbed. Warnanya mewarisi border aktif/pasif.
    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 6
        width 3
        length total-proportion=1.0
        position "right"
        corner-radius 6
    }

    // struts { }
}
