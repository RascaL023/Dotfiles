// Orchestrator: setiap fragmen punya satu pekerjaan.
// Urutan penting — include bersifat posisional, jadi warna dimuat terakhir
// agar menimpa nilai tampilan lain tanpa perlu menyentuh fragmen geometri.

include "conf/keybinds/keybind.kdl"
include "conf/layouts/layout.kdl"

// Rasa (gap, border, shadow, radius, opacity, blur, overview) dari matugen.
// Dimuat sebelum rule jendela agar opacity per-aplikasi tetap menang.
include optional=true "~/.myenv/theme/feel/current/niri/feel.kdl"

include "conf/core/autostart.kdl"
include "conf/core/input.kdl"
include "conf/core/output.kdl"
include "conf/core/session.kdl"
include "conf/core/environment.kdl"
include "conf/core/cursor.kdl"
include "conf/rule/layer.kdl"
include "conf/rule/window.kdl"
include "conf/animations.kdl"
include "conf/core/xwayland.kdl"

// Satu-satunya pemilik warna, dari matugen; dimuat terakhir agar menang.
include optional=true "~/.myenv/theme/palette/current/niri/palette.kdl"
