include "conf/keybinds/keybind.kdl"
include "conf/layouts/layout.kdl"

// AUTOSTART
spawn-sh-at-startup "noctalia"

// INPUT
input {
    keyboard {
        numlock
    }

    touchpad {
        tap
        natural-scroll
        scroll-method "two-finger"
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// OUTPUT
output "LVDS-1" {
    mode "1366x768@59.996"
    scale 1
    transform "normal"
    variable-refresh-rate
}

output "HDMI-A-1" {
    mode "1920x1080@75.000"
}

// SHELL
hotkey-overlay {
    skip-at-startup
}

environment {
    GDK_BACKEND "wayland"
    XDG_CURRENT_DESKTOP "niri"
}

prefer-no-csd

layer-rule {
    place-within-backdrop true
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// WINDOW RULES
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    opacity 0.9
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="ttyper"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.5; }
}

window-rule {
    match app-id="kitty-float"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.5; }
}

window-rule {
    match app-id="foot"
    opacity 0.9
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="kitty"
    opacity 1.0
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match is-focused=false
    opacity 0.85
    background-effect {
        blur false
        xray false
    }
}

// ANIMATIONS
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

xwayland-satellite {
    path "/nix/store/4xsm6aqa79mrpllrw688y5svxxh12x3j-xwayland-satellite-0.8.3/bin/xwayland-satellite"
}
