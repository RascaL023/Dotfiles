/* Shared behavior. Layouts and the Matugen palette live under themes/. */
configuration {
    modi: "drun,run,window";
    location: 5;
    show-icons: false;
    icon-theme: "Papirus";
    font: "JetBrainsMono Nerd Font 12";
    drun-display-format: "{name}";
    display-drun: " Apps ";
    display-run: " Run ";
    display-window: " Window ";
}

@theme "themes/default.rasi"
