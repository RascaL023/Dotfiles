/* Fullscreen wallpaper gallery; rows and thumbnails come from stdin. */
@import "shared/theme.rasi"

configuration {
    show-icons: true;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

/* Fullscreen clean */
window {
    fullscreen: true;
    background-color: @effect-scrim;
}

/* Layout utama */
mainbox {
    background-color: inherit;
    padding: 40px;
    children: [ listview, inputbar ];
}

/* Input bar */
inputbar {
    children: [ prompt, entry ];
    background-color: @layer-base;
    border-radius: 8px;
    padding: 7px 10px;
}

/* Prompt kiri */
prompt {
    background-color: @accent-prompt;
    padding: 8px 10px;
    text-color: @layer-base;
    border-radius: 6px;
}

/* Entry text */
entry {
    padding: 8px;
    placeholder: "Search wallpapers...";
    text-color: @text-primary;
    background-color: @layer-base;
    border-radius: 4px;
}

/* List (preview area) */
listview {
    columns: 2;
    spacing: 14px;
    background-color: transparent;
}

/* Element wallpaper (gambar doang) */
element {
    padding: 20px;
    background-color: transparent;
    border-radius: 12px;
    orientation: vertical;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    text-color: @text-primary;
}

/* Thumbnail bigger */
element-icon {
    size: 560px;
    border-radius: 12px;
}

/* Selected wallpaper (highlighted) */
element selected, element-text selected {
    background-color: @selection-accent-bg;
    text-color: @layer-base;
}
