;; ============================= Bar (tiruan waybar) =============================
;;
;; Mode pengembangan: dipasang 40px di bawah waybar supaya bisa dibandingkan
;; langsung, dan TIDAK ikut memesan ruang layar (:exclusive false) karena
;; waybar sudah memesannya - kalau dua-duanya memesan, jendela terdorong dua kali.
;;
;; Untuk menjadikan ini bar utama (menggantikan waybar):
;;   1. :y "0"          -> menempel di tepi atas
;;   2. :exclusive true -> niri memesan 35px (anchor harus memuat "center", OK)
;;   3. matikan waybar
;;
;; Catatan: `:reserve (struts ...)` adalah properti X11; di Wayland yang dipakai
;; `:exclusive` (lihat dokumentasi eww, defwindow-properties).
;;
;; KENAPA ADA `.bar-root` (kotak pembungkus kosong)
;; GTK menempatkan isi sebuah jendela menutupi seluruh jendela dan TIDAK
;; menghormati padding kotak terluar itu sendiri (terbukti lewat pengukuran:
;; padding pada kotak akar diabaikan, padding pada kotak bersarang dipakai),
;; padahal inset pill waybar (`margin: 5px 4px 0` pada `window#waybar > box`)
;; memang butuh padding. Jadi inset itu dipasang di kotak bersarang
;; `.bar-outer`, dan di atasnya perlu satu kotak akar transparan.

(include "widgets/bar.yuck")

(defwindow bar
  :monitor 0
  :stacking "fg"
  :exclusive true
  :focusable "none"
  :geometry (geometry
    :x "0"
    :y "0"
    :width "100%"
    :height "35px"
    :anchor "top center")
  (box :class "bar-root"
    (bar)))
