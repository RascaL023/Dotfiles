;;###################
;;###### Polls ######
;;###################

;; -

;;########################
;;###### Listeners #######
;;########################

(deflisten music-info
  :initial "No Music"
  `bash -c '
    {
      mpc idleloop player | while read e; do ./script/music-ctl; done &
      tail -F ~/.local/share/mpd/log -n 2 | while read e; do ./script/music-ctl "info"; done &
      wait
    }
'`)
(deflisten music-status "./script/music-ctl 'status'")
(deflisten music-cover "script/music-ctl 'cover'")
(deflisten music-progress 
  :initial "0:00|0:00|0"
  "while true; do ./script/music-ctl 'stream'; sleep 1; done")


;;##################
;;###### Vars ######
;;##################

(defvar music-control false)



;;###################
;;##### Windows #####
;;###################

(include "window/power-menu.yuck")
(include "window/distro.yuck")
(include "window/depth-clock.yuck")


;;#########################
;;##### Island module #####
;;#########################

;; One daemon, one config: this file is the only place that includes the island
;; module. Keeping every (include) here means each path is relative to this
;; directory, so nested-include resolution never matters.
(include "bar/island/island.yuck")
(include "bar/island/widgets/music.yuck")
(include "bar/island/widgets/right.yuck")
(include "bar/island/widgets/islands.yuck")
(include "bar/island/widgets/calendar.yuck")
(include "bar/island/window.yuck")
