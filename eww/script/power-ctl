action=$1

# close is lazy: eww-ctl does not start the daemon just to close profile
eww-ctl close profile 2>/dev/null || true

case $action in
    "shutdown")
        shutdown now
        ;;
    "reboot")
        reboot
        ;;
    "logout")
        loginctl terminate-user $USER
        # atau: pkill -KILL -u $USER
        ;;
    "sleep")
        systemctl suspend
        ;;
    "lock")
        hyprlock
        ;;
esac
