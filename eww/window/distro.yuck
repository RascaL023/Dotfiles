(include "widget/music.yuck")

(defwindow distro
  :monitor 0
  :stacking "fg"
  :focusable false
  :class "distro"
  :geometry (geometry
    :x "0"
    :y "0.3%"
    :width "25%"
    :height "15%"
    :anchor "top center"
  )
    (box
      :class "distro-wrapper"
      :orientation "v"
      :spacing 10
      :space-evenly false
      (box
        :class "content-container"
        :orientation "v"
        :spacing 10
        :halign "fill"
        :valign "center"
        (box 
          :orientation "h"
          :space-evenly false
          :spacing 10
          :halign "fill"
          :valign "center"
          (music-player)
        )
      )
    )
)
