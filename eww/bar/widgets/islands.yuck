(defwidget left-island []
  (box :halign "start" :valign "center" :class "island" :space-evenly false
    (button :visible {bar.modules.launcher} :class "control icon accent distro-icon"
      :tooltip "Applications" :onclick "./barctl action launcher" :timeout "5s" " ")
    (scroll :visible {bar.modules.workspaces} :class "workspace-scroll" :width {bar.workspaces.width}
      :hscroll true :vscroll false
      (box :space-evenly false
        (for ws in {bar.workspaces.items}
          (button :valign "center" :class "workspace ${ws.active ? 'active' : (ws.occupied ? 'occupied' : '')}"
            :active {bar.workspaces.available} :tooltip {ws.name}
            :onclick "./barctl action workspace ${ws.id}" :timeout "5s"
            (box :class "workspace-dot" :valign "center")))))
    (music-indicator)))

(defwidget clock-island []
  (button :halign "center" :valign "center" :visible {bar.modules.clock}
    :class "island clock" :tooltip {bar.clock.tooltip}
    :onclick "printf 'calendar-toggle\\n' > \"$EWW_BAR_EVENTS\"" :timeout "5s"
    (label :text {bar.clock.time})))

(include "widgets/right.yuck")
