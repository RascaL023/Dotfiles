(defvar volume-open false)
(defvar brightness-open false)

(include "widgets/islands.yuck")
(include "widgets/calendar.yuck")

(defwindow islands
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "1px" :anchor "top center")
  :exclusive true
  :focusable false
  :stacking "fg"
  :namespace "eww-islands"
  (centerbox :class "bar-frame islands-window" :orientation "h"
    (left-island)
    (clock-island)
    (right-island)))
