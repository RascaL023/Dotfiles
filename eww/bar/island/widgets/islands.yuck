(defwidget left-island []
  (box :halign "start" :valign "center" :class "island" :space-evenly false
    (button :visible {island.modules.launcher} :class "control icon accent distro-icon"
      :tooltip "Applications" :onclick "./eww-ctl bar island action launcher" :timeout "5s" " ")
    (scroll :visible {island.modules.workspaces} :class "workspace-scroll" :width {island.workspaces.width}
      :hscroll true :vscroll false
      (box :space-evenly false
        (for ws in {island.workspaces.items}
          (button :valign "center" :class "workspace ${ws.active ? 'active' : (ws.occupied ? 'occupied' : '')}"
            :active {island.workspaces.available} :tooltip {ws.name}
            :onclick "./eww-ctl bar island action workspace ${ws.id}" :timeout "5s"
            (box :class "workspace-dot" :valign "center")))))
    (music-indicator)))

(defwidget clock-island []
  (button :halign "center" :valign "center" :visible {island.modules.clock}
    :class "island clock" :tooltip {island.clock.tooltip}
    :onclick "printf 'calendar-toggle\\n' > \"$EWW_ISLAND_EVENTS\"" :timeout "5s"
    (label :text {island.clock.time})))
