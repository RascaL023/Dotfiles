{
  "monitor": "LVDS-1",
  "compositor": "auto",
  "modules": {
    "launcher": true,
    "workspaces": true,
    "music": true,
    "clock": true,
    "volume": true,
    "brightness": true,
    "network": true,
    "battery": true,
    "notifications": true,
    "power": true
  },
  "workspaces": [1, 2, 3, 4, 5],
  "intervals": {
    "battery": 30,
    "debounce": 0.15,
    "reconnect_max": 30,
    "command_timeout": 3
  },
  "brightness": {
    "device": "auto"
  },
  "music": {
    "mpris": true,
    "mpd": true,
    "preferred": ["mpd"],
    "mpd_bridges": ["mpd", "mpd-mpris"],
    "title_limit": 24
  },
  "commands": {
    "launcher": ["~/.config/rofi/launch.sh", "apps"],
    "network": ["kitty", "--class", "bar-network", "nmtui"],
    "notifications": ["swaync-client", "-t"],
    "dnd": ["swaync-client", "-d"],
    "menu": ["~/.config/rofi/launch.sh", "menu", "-no-custom"],
    "lock": ["hyprlock"],
    "suspend": ["systemctl", "suspend"],
    "logout": null,
    "reboot": ["systemctl", "reboot"],
    "shutdown": ["systemctl", "poweroff"]
  }
}
