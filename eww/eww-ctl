#!/usr/bin/env python3
"""One entry point for Eww: the daemon, the island module, root windows and reloads.

A daemon started anywhere else (a keybind, autostart, `eww open`) has no
EWW_ISLAND_EVENTS, so its island callbacks would fail silently. Every path here
goes through this launcher; `daemon restart` adopts a daemon started elsewhere.
"""
import argparse
import fcntl
import json
import os
import re
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent
ISLAND = ROOT / "bar" / "island"
sys.path.insert(0, str(ISLAND / "scripts"))
# Heavy imports (asyncio and the action module) stay inside the commands that
# need them: asyncio alone costs ~0.4 s on a cold interpreter, and this script
# runs on every click.

MODULE_WINDOWS = ("islands", "calendar-popup", "music-popup")
ROOT_WINDOWS = ("profile", "distro")


class CtlError(RuntimeError):
    pass


def eww(*args, check=True):
    # Eww 0.6.0 otherwise forks a second daemon on a 100 ms IPC read timeout.
    argv = ["eww", "--config", str(ROOT), "--force-wayland", "--no-daemonize", *args]
    result = subprocess.run(argv, text=True, capture_output=True, timeout=10)
    if check and result.returncode:
        raise CtlError((result.stderr or "").strip() or (result.stdout or "").strip() or "Eww command failed")
    return result


def alive():
    return eww("ping", check=False).returncode == 0


def windows():
    result = eww("active-windows", check=False)
    if result.returncode:
        return []
    return [line.split(":", 1)[0].strip() for line in result.stdout.splitlines() if ":" in line]


def identity(pid):
    """Start time of a pid that is really our daemon, or None."""
    try:
        path = Path("/proc") / str(pid)
        argv = (path / "cmdline").read_bytes().split(b"\0")
        stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
        if os.fsencode(ROOT) in argv and argv[0].split(b"/")[-1] == b"eww" and stat[0] != "Z":
            return int(stat[19])
    except (OSError, ValueError):
        pass
    return None


def managed_pid():
    from common import runtime_dir
    try:
        info = json.loads((runtime_dir() / "daemon.pid").read_text())
        if identity(info["pid"]) == info["start"]:
            return info["pid"]
    except (OSError, ValueError, KeyError):
        pass
    return None


def daemon_env():
    """The environment every daemon spawned here carries, always."""
    from common import runtime_dir
    return {**os.environ, "EWW_ISLAND_EVENTS": str(runtime_dir() / "events.fifo")}


def spawn_daemon():
    """Start the daemon through this launcher; False when one is already up."""
    from common import runtime_dir
    if alive():
        return False
    pid_file = runtime_dir() / "daemon.pid"
    if managed_pid() is not None:
        pid_file.unlink(missing_ok=True)
    with (runtime_dir() / "daemon.log").open("a") as log:
        proc = subprocess.Popen(["eww", "--config", str(ROOT), "--force-wayland",
                                 "--no-daemonize", "daemon"], stdin=subprocess.DEVNULL,
                                stdout=log, stderr=log, start_new_session=True, env=daemon_env())
    # Wait until the exec has replaced the child before recording its identity.
    for _ in range(100):
        stamp = identity(proc.pid)
        if stamp is not None:
            pid_file.write_text(json.dumps({"pid": proc.pid, "start": stamp}))
            break
        if proc.poll() is not None:
            raise CtlError("Eww daemon exited; inspect daemon.log")
        time.sleep(.02)
    for _ in range(50):
        if alive():
            return True
        time.sleep(.1)
    raise CtlError("Eww daemon did not become ready; inspect daemon.log")


def ensure_daemon():
    if spawn_daemon():
        return
    if managed_pid() is None:
        raise CtlError("the running Eww daemon was not started by eww-ctl; "
                       "run 'eww-ctl daemon restart' to take it over")


def wait_collector():
    import asyncio
    from actions import request
    for _ in range(100):
        try:
            asyncio.run(request("state"))
            return
        except (OSError, ValueError, RuntimeError):
            time.sleep(.05)
    raise CtlError("island collector did not start; inspect daemon.log")


def stop_collector():
    import asyncio
    from actions import request
    from common import runtime_dir
    try:
        asyncio.run(request("stop"))
    except (OSError, RuntimeError, ValueError, asyncio.TimeoutError):
        pass
    # Also covers a collector whose parent was killed unexpectedly.
    directory = runtime_dir()
    with (directory / "collector.lock").open("a") as lock:
        for _ in range(100):
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                time.sleep(.05)
        else:
            raise CtlError("island collector did not stop; inspect Eww logs")


def island_stop():
    """Close the island windows and its collector. The daemon keeps running."""
    present = set(windows())
    for name in MODULE_WINDOWS:
        if name in present:
            eww("close", name, check=False)
    stop_collector()


def island_start(cfg, monitor=None):
    ensure_daemon()
    if "islands" in windows():
        if monitor is None:
            return
        island_stop()
    from common import runtime_dir
    monitor = str(cfg["monitor"] if monitor is None else monitor)
    runtime_dir().joinpath("monitor").write_text(monitor)
    result = eww("open", "islands", "--screen", monitor, check=False)
    # A slow open can succeed on the GTK thread after the CLI's 100 ms timeout.
    for _ in range(50):
        if "islands" in windows():
            break
        time.sleep(.1)
    else:
        if "No window named" in (result.stderr or ""):
            # The daemon is still running a config from before this window existed.
            reload_daemon()
            result = eww("open", "islands", "--screen", monitor, check=False)
            for _ in range(50):
                if "islands" in windows():
                    break
                time.sleep(.1)
        if "islands" not in windows():
            island_stop()
            raise CtlError(result.stderr.strip() or "Eww failed to open islands")
    wait_collector()


def daemon_stop():
    from common import runtime_dir
    pid = managed_pid()
    requested = False
    if alive():
        requested = eww("kill", check=False).returncode == 0
    if pid and not requested and identity(pid) is not None:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    stop_collector()
    for _ in range(100):
        if not managed_pid() and not alive():
            (runtime_dir() / "daemon.pid").unlink(missing_ok=True)
            return
        time.sleep(.05)
    raise CtlError("Eww daemon did not stop")


def running_windows():
    present = set(windows())
    return [name for name in ("islands", *ROOT_WINDOWS, "depth-clock") if name in present]


def depth(mode):
    script = ROOT / "script" / "depth-ctl"
    if not script.is_file():
        raise CtlError("script/depth-ctl is missing")
    return subprocess.run([str(script), mode], check=False).returncode


def daemon_restart(cfg):
    was = running_windows()
    daemon_stop()
    ensure_daemon()
    if "islands" in was:
        from common import runtime_dir
        selected = runtime_dir() / "monitor"
        island_start(cfg, selected.read_text().strip() if selected.exists() else None)
    for name in ROOT_WINDOWS:
        if name in was:
            eww("open", name, check=False)
    if "depth-clock" in was:
        depth("start")


def window(action, name):
    if name == "depth-clock":
        return depth({"open": "start", "close": "stop", "toggle": "toggle"}[action])
    ensure_daemon()
    if action == "toggle":
        action = "close" if name in windows() else "open"
    result = eww(action, name, check=False)
    if action == "open":
        for _ in range(50):
            if name in windows():
                return 0
            time.sleep(.1)
        raise CtlError(result.stderr.strip() or f"Eww failed to open {name}")
    return result.returncode


def reload_daemon():
    from common import settings
    settings()  # Validate before touching a working daemon.
    if not alive():
        raise CtlError("Eww daemon is not running")
    result = eww("reload", check=False)
    if result.returncode:
        raise CtlError(result.stderr.strip() or "Eww reload failed")
    if "islands" in windows():
        wait_collector()


def validate():
    """Static checks only: no daemon, no window, no session side effects."""
    scss = ROOT / "eww.scss"
    result = subprocess.run(["sassc", str(scss)], capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise CtlError("sassc: " + (result.stderr or "").strip())
    for target in re.findall(r'@import "([^"]+)"', scss.read_text()):
        if target.startswith("/"):
            continue
        base = ROOT / target
        candidates = (base.with_suffix(".scss"), base.parent / ("_" + base.name + ".scss"))
        if not any(path.is_file() for path in candidates):
            raise CtlError(f"missing SCSS import: {target}")
    for path in sorted((ISLAND / "scripts").glob("*.py")):
        compile(path.read_text(), str(path), "exec")
    from common import settings
    settings()
    for path in sorted(ROOT.glob("**/*.yuck")):
        if re.search(r"\bbar\.", path.read_text()):
            raise CtlError(f"legacy `bar.` variable in {path.relative_to(ROOT)}")
    for include in re.findall(r'\(include "([^"]+)"\)', (ROOT / "eww.yuck").read_text()):
        if not (ROOT / include).is_file():
            raise CtlError(f"missing include: {include}")
    print("validate: OK")


def doctor(cfg):
    import asyncio
    from actions import request
    from common import compositor_name, initial_state, runtime_dir
    initial_state(cfg)
    backend = compositor_name(cfg)
    print(f"Config: {ROOT}\nIsland: {ISLAND}\nSettings: OK\nCompositor: {backend}\n"
          f"Monitor: {cfg['monitor']}\nRuntime: {runtime_dir()}")
    names = {"eww", "python3"}
    dependencies = {"workspaces": ("niri" if backend == "niri" else "hyprctl",),
                    "volume": ("wpctl", "pw-dump"), "brightness": ("brightnessctl", "udevadm"),
                    "network": ("nmcli",), "notifications": ("swaync-client",)}
    for module, tools in dependencies.items():
        if cfg["modules"][module]:
            names.update(tools)
    if cfg["modules"]["music"]:
        if cfg["music"]["mpris"]:
            names.update(("playerctl", "dbus-monitor"))
        if cfg["music"]["mpd"]:
            names.add("mpc")
    names.update(argv[0] for argv in cfg["commands"].values())
    for name in sorted(names):
        print(f"{'OK' if shutil.which(name) else 'MISSING'}  {name}")
    for name in ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
                 "NIRI_SOCKET" if backend == "niri" else "HYPRLAND_INSTANCE_SIGNATURE",
                 "DBUS_SESSION_BUS_ADDRESS"):
        print(f"{'OK' if os.environ.get(name) else 'MISSING'}  {name}")
    print(eww("--version").stdout.strip())
    families = re.findall(r'^\$(?:font|icon-font):\s*"([^"]+)"',
                          (ISLAND / "styles/_tokens.scss").read_text(), re.M)
    for family in dict.fromkeys(families):
        if shutil.which("fc-match"):
            result = subprocess.run(["fc-match", family], capture_output=True, text=True, timeout=3)
            print(f"Font {family}: {result.stdout.strip()}")
    pid = managed_pid()
    print("Daemon: " + ("running" if alive() else "stopped") + (f" (pid {pid})" if pid else ""))
    print("Windows: " + (" ".join(windows()) or "none"))
    if alive():
        try:
            state = asyncio.run(request("state"))["state"]
            for name in ("workspaces", "music", "volume", "brightness", "network", "battery", "notifications"):
                print(f"{name}: {'available' if state[name]['available'] else 'unavailable / disabled'}")
        except (OSError, RuntimeError):
            print("Collector unavailable")


def main():
    parser = argparse.ArgumentParser(
        prog="eww-ctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=("The daemon is only started here: autostart, keybinds and theme hooks call\n"
                "eww-ctl, because a daemon started any other way has no island FIFO.\n"
                "Exit: 0 ok, 1 failed, 2 usage."))
    sub = parser.add_subparsers(dest="command", required=True)
    daemon = sub.add_parser("daemon", help="daemon lifecycle (the one start path)")
    daemon.add_argument("action", choices=("start", "stop", "restart", "status"))
    bar = sub.add_parser("bar", help="bar modules; the island bar lives here")
    bar_modules = bar.add_subparsers(dest="module", required=True)
    island = bar_modules.add_parser("island", help="island bar: windows, collector and settings")
    island.add_argument("action", choices=("start", "stop", "toggle", "reload", "status",
                                           "doctor", "action"))
    island.add_argument("name", nargs="?")
    island.add_argument("argument", nargs="?")
    island.add_argument("--monitor", help="connector name or Eww monitor index (start/toggle)")
    for name, text in (("open", "open a window"), ("close", "close a window"),
                       ("toggle", "toggle a window")):
        window_parser = sub.add_parser(name, help=text)
        window_parser.add_argument("window")
    sub.add_parser("reload", help="reload Yuck/SCSS without restarting the daemon")
    sub.add_parser("status", help="daemon state and open windows")
    sub.add_parser("validate", help="compile SCSS/Python, validate settings and includes")
    args = parser.parse_args()

    if args.command == "daemon":
        if args.action == "status":
            pid = managed_pid()
            print(f"running pid {pid}" if pid else
                  ("running (not managed)" if alive() else "stopped"))
        elif args.action == "start":
            ensure_daemon()
        elif args.action == "stop":
            daemon_stop()
        else:
            from common import settings
            daemon_restart(settings())
        return 0
    if args.command == "bar":
        from common import runtime_dir, settings
        cfg = settings()
        if args.action == "action":
            import asyncio
            from actions import local_action, request
            if not args.name:
                raise CtlError("action needs a name")
            if not local_action(args.name, cfg):
                try:
                    asyncio.run(request(args.name, args.argument))
                except OSError as exc:
                    raise CtlError(f"island collector is not running ({exc})") from None
        elif args.action == "start":
            island_start(cfg, args.monitor)
        elif args.action == "stop":
            island_stop()
        elif args.action == "toggle":
            if "islands" in windows():
                island_stop()
            else:
                island_start(cfg, args.monitor)
        elif args.action == "reload":
            if "islands" not in windows():
                print("island: stopped")
                return 0
            selected = runtime_dir() / "monitor"
            monitor = selected.read_text().strip() if selected.exists() else str(cfg["monitor"])
            island_stop()
            island_start(cfg, monitor)
        elif args.action == "status":
            print(" ".join(name for name in windows() if name in MODULE_WINDOWS) or "stopped")
        else:
            doctor(cfg)
        return 0
    if args.command in ("open", "close", "toggle"):
        return window(args.command, args.window)
    if args.command == "reload":
        reload_daemon()
        return 0
    if args.command == "status":
        pid = managed_pid()
        print(f"daemon   {'running pid ' + str(pid) if pid else ('running (not managed)' if alive() else 'stopped')}")
        print(f"windows  {' '.join(windows()) or 'none'}")
        return 0
    validate()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, CtlError, subprocess.TimeoutExpired) as exc:
        print(f"eww-ctl: {exc}", file=sys.stderr)
        sys.exit(1)
