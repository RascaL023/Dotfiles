#!/usr/bin/env python3
"""One entry point for Eww: the daemon, the island module, root windows and reloads.

A daemon started anywhere else (a keybind, autostart, `eww open`) has no
EWW_ISLAND_EVENTS, so its island callbacks would fail silently. Every path here
goes through this launcher; `daemon restart` adopts a daemon started elsewhere.
"""
import os
import sys
import time

ROOT = os.path.dirname(os.path.realpath(__file__))
ISLAND = os.path.join(ROOT, "bar", "island")
sys.path.insert(0, os.path.join(ISLAND, "scripts"))
# Startup budget: only os/sys/time are imported here. Everything else (json,
# subprocess, fcntl, re, shutil, signal, and pathlib via common) is imported by
# the command that needs it, so `--help` and `status` stay fast.

MODULE_WINDOWS = ("islands", "calendar-popup", "music-popup")
ROOT_WINDOWS = ("profile", "distro")

USAGE = """\
usage: eww-ctl <command> [args...]

One entry point for Eww: the daemon, the island module, root windows and reloads.

commands:
  daemon start|stop|restart|status        daemon lifecycle (the one start path)
  bar island start|stop|toggle|reload|status|doctor|action
                                          island bar: windows, collector and settings
  open|close|toggle <window>              window control (depth-clock via depth-ctl)
  reload                                  reload Yuck/SCSS without restarting the daemon
  status                                  daemon state and open windows
  validate                                compile SCSS/Python, validate settings and includes

options:
  -h, --help                              show this help and exit
  --monitor <connector|index>             monitor for `bar island start|toggle`

A daemon started anywhere else (a keybind, autostart, `eww open`) has no
EWW_ISLAND_EVENTS, so its island callbacks would fail silently. Every path here
goes through this launcher; `daemon restart` adopts a daemon started elsewhere.
Exit: 0 ok, 1 failed, 2 usage.
"""

DAEMON_USAGE = """\
usage: eww-ctl daemon start|stop|restart|status

  start     Start the daemon through this launcher (the only start path)
  stop      Close every window, stop the collector, kill the daemon
  restart   Adopt a foreign daemon and reopen the windows that were open
  status    Print the daemon pid, or stopped / running (not managed)
"""

BAR_USAGE = """\
usage: eww-ctl bar island <action> [name] [argument] [--monitor M]

  start     Open the island window, then wait for its collector
  stop      Close island windows and the collector; the daemon keeps running
  toggle    Stop when the island is open, start when it is closed
  reload    Close and reopen the island, keeping the last monitor
  status    Island windows, or "stopped"
  doctor    Settings, dependencies, fonts, daemon and module availability
  action    Send one allowlisted action through the collector socket
"""

WINDOW_USAGE = """\
usage: eww-ctl open|close|toggle <window>

  windows   islands, calendar-popup, music-popup, profile, distro, depth-clock
  depth-clock is delegated to script/depth-ctl so its geometry is measured.
  close never starts a stopped daemon; open and toggle do.
"""


class CtlError(RuntimeError):
    pass


def fail(message):
    print(f"eww-ctl: {message} (use --help)", file=sys.stderr)
    return 2


def eww(*args, check=True):
    import subprocess
    # Eww 0.6.0 otherwise forks a second daemon on a 100 ms IPC read timeout.
    argv = ["eww", "--config", ROOT, "--force-wayland", "--no-daemonize", *args]
    try:
        result = subprocess.run(argv, text=True, capture_output=True, timeout=10)
    except subprocess.TimeoutExpired:
        raise CtlError("Eww command timed out; inspect daemon.log") from None
    if check and result.returncode:
        raise CtlError((result.stderr or "").strip() or (result.stdout or "").strip() or "Eww command failed")
    return result


def alive():
    return eww("ping", check=False).returncode == 0


def parse_windows(result):
    if result.returncode:
        return []
    return [line.split(":", 1)[0].strip() for line in result.stdout.splitlines() if ":" in line]


def windows():
    return parse_windows(eww("active-windows", check=False))


def identity(pid):
    """Start time of a pid that is really our daemon, or None."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            argv = handle.read().split(b"\0")
        with open(f"/proc/{pid}/stat") as handle:
            stat = handle.read().rsplit(")", 1)[1].split()
        if os.fsencode(ROOT) in argv and argv[0].split(b"/")[-1] == b"eww" and stat[0] != "Z":
            return int(stat[19])
    except (OSError, ValueError, IndexError):
        pass
    return None


def managed_pid():
    import json
    from common import runtime_dir
    try:
        info = json.loads((runtime_dir() / "daemon.pid").read_text())
        if identity(info["pid"]) == info["start"]:
            return info["pid"]
    except (OSError, ValueError, KeyError):
        pass
    return None


def daemon_env():
    """The environment every daemon spawned here carries, always."""
    from common import runtime_dir
    return {**os.environ, "EWW_ISLAND_EVENTS": str(runtime_dir() / "events.fifo")}


def spawn_daemon():
    """Start the daemon through this launcher; False when one is already up."""
    import json
    import subprocess
    from common import runtime_dir
    if alive():
        return False
    pid_file = runtime_dir() / "daemon.pid"
    if managed_pid() is not None:
        pid_file.unlink(missing_ok=True)
    with (runtime_dir() / "daemon.log").open("a") as log:
        proc = subprocess.Popen(["eww", "--config", ROOT, "--force-wayland",
                                 "--no-daemonize", "daemon"], stdin=subprocess.DEVNULL,
                                stdout=log, stderr=log, start_new_session=True, env=daemon_env())
    # Wait until the exec has replaced the child before recording its identity.
    for _ in range(100):
        stamp = identity(proc.pid)
        if stamp is not None:
            pid_file.write_text(json.dumps({"pid": proc.pid, "start": stamp}))
            break
        if proc.poll() is not None:
            raise CtlError("Eww daemon exited; inspect daemon.log")
        time.sleep(.02)
    for _ in range(50):
        if alive():
            return True
        time.sleep(.1)
    raise CtlError("Eww daemon did not become ready; inspect daemon.log")


def ensure_daemon():
    if spawn_daemon():
        return
    if managed_pid() is None:
        raise CtlError("the running Eww daemon was not started by eww-ctl; "
                       "run 'eww-ctl daemon restart' to take it over")


def wait_collector():
    import asyncio
    from actions import request
    for _ in range(100):
        try:
            asyncio.run(request("state"))
            return
        except (OSError, ValueError, RuntimeError):
            time.sleep(.05)
    raise CtlError("island collector did not start; inspect daemon.log")


def stop_collector():
    import asyncio
    import fcntl
    from actions import request
    from common import runtime_dir
    try:
        asyncio.run(request("stop"))
    except (OSError, RuntimeError, ValueError, asyncio.TimeoutError):
        pass
    # Also covers a collector whose parent was killed unexpectedly.
    directory = runtime_dir()
    with (directory / "collector.lock").open("a") as lock:
        for _ in range(100):
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                time.sleep(.05)
        else:
            raise CtlError("island collector did not stop; inspect Eww logs")


def island_stop():
    """Close the island windows and its collector. The daemon keeps running."""
    present = set(windows())
    for name in MODULE_WINDOWS:
        if name in present:
            eww("close", name, check=False)
    stop_collector()


def island_start(cfg, monitor=None):
    ensure_daemon()
    if "islands" in windows():
        if monitor is None:
            return
        island_stop()
    from common import runtime_dir
    monitor = str(cfg["monitor"] if monitor is None else monitor)
    runtime_dir().joinpath("monitor").write_text(monitor)
    result = eww("open", "islands", "--screen", monitor, check=False)
    # A slow open can succeed on the GTK thread after the CLI's 100 ms timeout.
    for _ in range(50):
        if "islands" in windows():
            break
        time.sleep(.1)
    else:
        if "No window named" in (result.stderr or ""):
            # The daemon is still running a config from before this window existed.
            reload_daemon()
            result = eww("open", "islands", "--screen", monitor, check=False)
            for _ in range(50):
                if "islands" in windows():
                    break
                time.sleep(.1)
        if "islands" not in windows():
            island_stop()
            raise CtlError(result.stderr.strip() or "Eww failed to open islands")
    wait_collector()


def daemon_stop():
    import signal
    from common import runtime_dir
    pid = managed_pid()
    requested = False
    if alive():
        requested = eww("kill", check=False).returncode == 0
    if pid and not requested and identity(pid) is not None:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    stop_collector()
    for _ in range(100):
        if not managed_pid() and not alive():
            (runtime_dir() / "daemon.pid").unlink(missing_ok=True)
            return
        time.sleep(.05)
    raise CtlError("Eww daemon did not stop")


def running_windows():
    present = set(windows())
    return [name for name in ("islands", *ROOT_WINDOWS, "depth-clock") if name in present]


def depth(mode):
    import subprocess
    script = os.path.join(ROOT, "script", "depth-ctl")
    if not os.path.isfile(script):
        raise CtlError("script/depth-ctl is missing")
    try:
        return subprocess.run([script, mode], check=False).returncode
    except subprocess.TimeoutExpired:
        raise CtlError("depth-ctl timed out") from None


def daemon_restart(cfg):
    was = running_windows()
    daemon_stop()
    ensure_daemon()
    if "islands" in was:
        from common import runtime_dir
        selected = runtime_dir() / "monitor"
        island_start(cfg, selected.read_text().strip() if selected.exists() else None)
    for name in ROOT_WINDOWS:
        if name in was:
            eww("open", name, check=False)
    if "depth-clock" in was:
        depth("start")


def close_window(name):
    # Closing must never resurrect a daemon that is already gone.
    if not alive():
        return 0
    return eww("close", name, check=False).returncode


def window(action, name):
    if name == "depth-clock":
        return depth({"open": "start", "close": "stop", "toggle": "toggle"}[action])
    if action == "close":
        return close_window(name)
    ensure_daemon()
    if action == "toggle":
        action = "close" if name in windows() else "open"
    result = eww(action, name, check=False)
    if action == "open":
        for _ in range(50):
            if name in windows():
                return 0
            time.sleep(.1)
        raise CtlError(result.stderr.strip() or f"Eww failed to open {name}")
    return result.returncode


def reload_daemon():
    from common import settings
    settings()  # Validate before touching a working daemon.
    if not alive():
        raise CtlError("Eww daemon is not running")
    result = eww("reload", check=False)
    if result.returncode:
        raise CtlError(result.stderr.strip() or "Eww reload failed")
    if "islands" in windows():
        wait_collector()


def validate():
    """Static checks only: no daemon, no window, no session side effects."""
    import re
    import subprocess
    scss = os.path.join(ROOT, "eww.scss")
    try:
        result = subprocess.run(["sassc", scss], capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        raise CtlError("sassc timed out") from None
    if result.returncode:
        raise CtlError("sassc: " + (result.stderr or "").strip())
    with open(scss) as handle:
        stylesheet = handle.read()
    for target in re.findall(r'@import "([^"]+)"', stylesheet):
        if target.startswith("/"):
            continue
        base = os.path.join(ROOT, target)
        candidates = (base + ".scss", os.path.join(os.path.dirname(base), "_" + os.path.basename(base) + ".scss"))
        if not any(os.path.isfile(path) for path in candidates):
            raise CtlError(f"missing SCSS import: {target}")
    scripts = os.path.join(ISLAND, "scripts")
    for name in sorted(os.listdir(scripts)):
        if not name.endswith(".py"):
            continue
        path = os.path.join(scripts, name)
        with open(path) as handle:
            compile(handle.read(), path, "exec")
    from common import settings
    settings()
    for directory, subdirectories, files in os.walk(ROOT):
        subdirectories[:] = [name for name in subdirectories if name not in (".git", "__pycache__")]
        for name in files:
            if not name.endswith(".yuck"):
                continue
            path = os.path.join(directory, name)
            with open(path) as handle:
                if re.search(r"\bbar\.", handle.read()):
                    raise CtlError(f"legacy `bar.` variable in {os.path.relpath(path, ROOT)}")
    with open(os.path.join(ROOT, "eww.yuck")) as handle:
        root_yuck = handle.read()
    for include in re.findall(r'\(include "([^"]+)"\)', root_yuck):
        if not os.path.isfile(os.path.join(ROOT, include)):
            raise CtlError(f"missing include: {include}")
    print("validate: OK")


def doctor(cfg):
    import asyncio
    import re
    import shutil
    from actions import request
    from common import compositor_name, initial_state, runtime_dir
    initial_state(cfg)
    backend = compositor_name(cfg)
    print(f"Config: {ROOT}\nIsland: {ISLAND}\nSettings: OK\nCompositor: {backend}\n"
          f"Monitor: {cfg['monitor']}\nRuntime: {runtime_dir()}")
    names = {"eww", "python3"}
    dependencies = {"workspaces": ("niri" if backend == "niri" else "hyprctl",),
                    "volume": ("wpctl", "pw-dump"), "brightness": ("brightnessctl", "udevadm"),
                    "network": ("nmcli",), "notifications": ("swaync-client",)}
    for module, tools in dependencies.items():
        if cfg["modules"][module]:
            names.update(tools)
    if cfg["modules"]["music"]:
        if cfg["music"]["mpris"]:
            names.update(("playerctl", "dbus-monitor"))
        if cfg["music"]["mpd"]:
            names.add("mpc")
    names.update(argv[0] for argv in cfg["commands"].values())
    for name in sorted(names):
        print(f"{'OK' if shutil.which(name) else 'MISSING'}  {name}")
    for name in ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
                 "NIRI_SOCKET" if backend == "niri" else "HYPRLAND_INSTANCE_SIGNATURE",
                 "DBUS_SESSION_BUS_ADDRESS"):
        print(f"{'OK' if os.environ.get(name) else 'MISSING'}  {name}")
    print(eww("--version").stdout.strip())
    with open(os.path.join(ISLAND, "styles", "_tokens.scss")) as handle:
        families = re.findall(r'^\$(?:font|icon-font):\s*"([^"]+)"', handle.read(), re.M)
    for family in dict.fromkeys(families):
        if shutil.which("fc-match"):
            try:
                result = subprocess.run(["fc-match", family], capture_output=True, text=True, timeout=3)
            except subprocess.TimeoutExpired:
                print(f"Font {family}: fc-match timed out")
                continue
            print(f"Font {family}: {result.stdout.strip()}")
    pid = managed_pid()
    print("Daemon: " + ("running" if alive() else "stopped") + (f" (pid {pid})" if pid else ""))
    print("Windows: " + (" ".join(windows()) or "none"))
    if alive():
        try:
            state = asyncio.run(request("state"))["state"]
            for name in ("workspaces", "music", "volume", "brightness", "network", "battery", "notifications"):
                print(f"{name}: {'available' if state[name]['available'] else 'unavailable / disabled'}")
        except (OSError, RuntimeError):
            print("Collector unavailable")


def island_command(action, name, argument, monitor):
    if action == "status":
        print(" ".join(window for window in windows() if window in MODULE_WINDOWS) or "stopped")
        return 0
    from common import runtime_dir, settings
    cfg = settings()
    if action == "action":
        import asyncio
        from actions import local_action, request
        if not name:
            raise CtlError("action needs a name")
        if not local_action(name, cfg):
            try:
                asyncio.run(request(name, argument))
            except OSError as exc:
                raise CtlError(f"island collector is not running ({exc})") from None
    elif action == "start":
        island_start(cfg, monitor)
    elif action == "stop":
        island_stop()
    elif action == "toggle":
        if "islands" in windows():
            island_stop()
        else:
            island_start(cfg, monitor)
    elif action == "reload":
        if "islands" not in windows():
            print("island: stopped")
            return 0
        selected = runtime_dir() / "monitor"
        monitor = selected.read_text().strip() if selected.exists() else str(cfg["monitor"])
        island_stop()
        island_start(cfg, monitor)
    else:
        doctor(cfg)
    return 0


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        print(USAGE, file=sys.stderr)
        return 2
    command, rest = args[0], args[1:]
    if command in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    if command == "daemon":
        if rest and rest[0] in ("-h", "--help"):
            print(DAEMON_USAGE)
            return 0
        if not rest:
            return fail("daemon needs an action (start|stop|restart|status)")
        action = rest[0]
        if action not in ("start", "stop", "restart", "status"):
            return fail(f"unknown daemon action: {action}")
        if len(rest) > 1:
            return fail(f"unexpected argument: {rest[1]}")
        if action == "status":
            pid = managed_pid()
            print(f"running pid {pid}" if pid else
                  ("running (not managed)" if alive() else "stopped"))
        elif action == "start":
            ensure_daemon()
        elif action == "stop":
            daemon_stop()
        else:
            from common import settings
            daemon_restart(settings())
        return 0
    if command == "bar":
        if rest and rest[0] in ("-h", "--help"):
            print(BAR_USAGE)
            return 0
        if not rest:
            return fail("bar needs a module (island)")
        if rest[0] != "island":
            return fail(f"unknown bar module: {rest[0]}")
        rest = rest[1:]
        if rest and rest[0] in ("-h", "--help"):
            print(BAR_USAGE)
            return 0
        if not rest:
            return fail("bar island needs an action (start|stop|toggle|reload|status|doctor|action)")
        action = rest[0]
        if action not in ("start", "stop", "toggle", "reload", "status", "doctor", "action"):
            return fail(f"unknown island action: {action}")
        values, monitor, index = [], None, 1
        while index < len(rest):
            value = rest[index]
            if value in ("-h", "--help"):
                print(BAR_USAGE)
                return 0
            if value == "--monitor":
                if index + 1 >= len(rest):
                    return fail("--monitor needs a connector name or index")
                monitor = rest[index + 1]
                index += 2
                continue
            if value.startswith("--monitor="):
                monitor = value.split("=", 1)[1]
                index += 1
                continue
            values.append(value)
            index += 1
        if len(values) > 2:
            return fail(f"unexpected argument: {values[2]}")
        return island_command(action, values[0] if values else None,
                              values[1] if len(values) > 1 else None, monitor)
    if command in ("open", "close", "toggle"):
        if rest and rest[0] in ("-h", "--help"):
            print(WINDOW_USAGE)
            return 0
        if not rest:
            return fail(f"{command} needs a window")
        if len(rest) > 1:
            return fail(f"unexpected argument: {rest[1]}")
        return window(command, rest[0])
    if command == "reload":
        if rest:
            return fail(f"unexpected argument: {rest[0]}")
        reload_daemon()
        return 0
    if command == "status":
        if rest:
            return fail(f"unexpected argument: {rest[0]}")
        pid = managed_pid()
        # One IPC call answers both questions: a failed query means no daemon.
        result = eww("active-windows", check=False)
        state = (f"running pid {pid}" if pid else
                 ("running (not managed)" if result.returncode == 0 else "stopped"))
        print(f"daemon   {state}")
        print(f"windows  {' '.join(parse_windows(result)) or 'none'}")
        return 0
    if command == "validate":
        if rest:
            return fail(f"unexpected argument: {rest[0]}")
        validate()
        return 0
    return fail(f"unknown command: {command}")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, CtlError) as exc:
        print(f"eww-ctl: {exc}", file=sys.stderr)
        sys.exit(1)
