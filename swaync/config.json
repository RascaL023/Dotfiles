{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "ignore-gtk-theme": true,
  "cssPriority": "user",

  "positionX": "left",
  "positionY": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,

  "control-center-layer": "top",
  "control-center-width": 340,
  "control-center-margin-top": 7,
  "control-center-margin-bottom": 7,
  "control-center-margin-right": 0,
  "control-center-margin-left": 7,
  "fit-to-screen": true,
  "text-empty": "No Notifications",
  "keyboard-shortcuts": true,

  "notification-window-width": 340,
  "notification-body-image-width": 300,
  "notification-body-image-height": 170,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "relative-timestamps": true,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 150,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "title",
    "mpris",
    "notifications",
    "volume",
    "backlight",
    "buttons-grid"
  ],

  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "Ra$caL",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "mpris": {
      "autohide": true,
      "loop-carousel": false,
      "blacklist": [
        "playerctld"
      ]
    },
    "volume": {
      "label": ""
    },
    "backlight": {
      "label": "󰃞"
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "",
          "command": "kitty nmtui",
          "tooltip": "Network"
        },
        {
          "label": "󰂛",
          "command": "swaync-client -d",
          "type": "toggle",
          "tooltip": "Do Not Disturb"
        },
        {
          "label": "󰈙",
          "command": "kitty yazi",
          "tooltip": "Files"
        },
        {
          "label": "",
          "command": "hyprlock",
          "tooltip": "Lock"
        },
        {
          "label": "󰜉",
          "command": "reboot",
          "tooltip": "Reboot"
        },
        {
          "label": "⏻",
          "command": "shutdown now",
          "tooltip": "Power Off"
        }
      ]
    }
  }
}
