{
  "meta": {
    "name": "default",
    "version": 1
  },

  "font": {
    "ui": {
      "text": "MapleMono NF",
      "title": "Monocraft Nerd Font",
      "tooltip": "FiraCodeNerdFontMono"
    },
    "icon": "JetBrainsMono Nerd Font",
    "system": "Cantarell Regular",
    "terminal": "MapleMono NF",
    "weight": {
      "normal": 500,
      "strong": 600
    },
    "size": {
      "small": 7,
      "normal": 11,
      "large": 15
    }
  },

  "shape": {
    "radius": 4,
    "rounding_power": 2.0,
    "border": 2,
    "gaps_in": 4,
    "gaps_out": 7,
    "border_angle": 45,
    "border_part_of_window": false
  },
  "surface": {
    "active_opacity": 1.0,
    "inactive_opacity": 1.0,
    "fullscreen_opacity": 1.0,
    "dim_inactive": false,
    "dim_strength": 0.0,
    "dim_around": 0.0,
    "terminal_opacity": 0.9
  },
  "material": {
    "blur": {
      "enabled": true,
      "size": 4,
      "passes": 4,
      "noise": 0.0,
      "contrast": 1.0,
      "brightness": 1.0,
      "vibrancy": 0.0,
      "vibrancy_darkness": 0.0,
      "xray": false,
      "popups": false,
      "ignore_opacity": true,
      "new_optimizations": true
    },
    "shadow": {
      "enabled": true,
      "range": 20,
      "power": 10,
      "sharp": false
    }
  },
  "motion": {
    "speed": 1.0,
    "curve": {
      "x1": 0.05,
      "y1": 0.9,
      "x2": 0.1,
      "y2": 1.05
    },
    "style_in": "popin",
    "style_out": "gnomed",
    "style_ws_in": "slidefade",
    "style_ws_out": "slidefade",
    "layers_speed": 1.0
  },
  "chrome": {
    "layer_blur": true,
    "rofi_radius": 10,
    "font_family": "",
    "groupbar": {
      "enabled": false,
      "gradient": true,
      "height": 14,
      "radius": 4
    }
  }
}
