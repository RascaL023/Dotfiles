// ############################
// ## Generated with Matugen ##
// ############################
// ## Manual edit is not recomended,
// ## Except for testing.

* {
  // ── Aksen ──
  accent-primary        : {{ accent.primary }};
  accent-secondary      : {{ accent.secondary }};
  accent-on             : {{ accent.on_primary }};
  accent-prompt         : {{ accent.primary }};

  // ── Teks ──
  text-primary          : {{ text.primary }};
  text-secondary        : {{ text.secondary }};
  text-muted            : {{ text.muted }};

  // ── Layer (urutan dan pemetaan mengikuti palet CSS) ──
  layer-base            : {{ surface.base }};
  layer-mantle          : {{ surface.lowest }};
  layer-crust           : {{ surface.low }};
  layer-surface         : {{ surface.medium }};
  layer-surface-raised  : {{ surface.high }};
  layer-surface-overlay : {{ surface.highest }};

  // ── Border ──
  border-default        : {{ border.default }};
  border-active         : {{ border.active }};
  border-medium         : {{ border.medium }};

  // ── Seleksi ──
  selection-bg          : {{ surface.medium }};
  selection-fg          : {{ text.primary }};
  selection-accent-bg   : {{ accent.primary }};

  // ── Efek ──
  effect-scrim          : {{ effect.scrim | to_color | set_alpha: 0.45 | format: rgba }};

  // ── Ukuran (bukan warna) ──
  launcher-width        : 45%;
  wallpaper-width       : 100%;
  window-radius         : {{ feel.chrome.rofi_radius }}px;
}
