// ############################
// ## Generated with Matugen ##
// ############################
// ## Manual edit is not recomended,
// ## Except for testing.


* {
  // ── Aksen ──
  accent-primary        : {{ colors.primary.default.hex }};
  accent-secondary      : {{ colors.secondary.default.hex }};
  accent-on             : {{ colors.on_primary.default.hex }};
  accent-prompt         : {{ colors.primary.default.hex | lighten: -10 }};

  // ── Teks ──
  text-primary          : {{ colors.on_surface.default.hex }};
  text-secondary        : {{ colors.on_surface_variant.default.hex }};
  text-muted            : {{ colors.on_surface_variant.default.rgba | set_alpha: 0.7 }};

  // ── Layer (urutan dan pemetaan mengikuti palet CSS) ──
  layer-base            : {{ colors.surface.default.hex }};
  layer-mantle          : {{ colors.surface_container_low.default.hex }};
  layer-crust           : {{ colors.surface_container_lowest.default.hex }};
  layer-surface         : {{ colors.surface_container.default.hex }};
  layer-surface-raised  : {{ colors.surface_container_high.default.hex }};
  layer-surface-overlay : {{ colors.surface_container_highest.default.hex }};

  // ── Border ──
  border-default        : {{ colors.surface_container_high.default.hex }};
  border-active         : {{ colors.primary.default.hex }};
  border-medium         : {{ colors.outline_variant.default.hex }};

  // ── Seleksi ──
  selection-bg          : {{ colors.primary.default.hex | lighten: -10 }};
  selection-fg          : {{ colors.surface.default.hex }};
  // selection-accent-bg : {{ colors.secondary_container.default.hex }};
  selection-accent-bg   : {{ colors.secondary.default.hex | lighten: -10 }};

  // ── Efek ──
  effect-scrim          : {{ colors.scrim.default.hex_alpha | to_color | set_alpha: 0.3 | format: hex_alpha }};

  // ── Ukuran (bukan warna) ──
  launcher-width        : 45%;
  wallpaper-width       : 100%;
  window-radius         : 10px;
}
