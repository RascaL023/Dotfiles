// ## Manual edit is not recomended,
// ## Except for testing.


* {
  bg-col                : {{ colors.surface.default.hex }};
  bg-selected-col       : {{ colors.primary.default.hex | lighten: -10 }};
  // alt-bg-selected-col   : {{ colors.secondary_container.default.hex }};
  alt-bg-selected-col   : {{ colors.secondary.default.hex | lighten: -10 }};
  bg-transparent-col    : {{ colors.scrim.default.hex_alpha | to_color | set_alpha: 0.3 | format: hex_alpha }};
  fg-col                : {{ colors.on_surface.default.hex }};
  fg-selected-col       : {{ colors.surface.default.hex }};
  accent-1              : {{ colors.primary.default.hex | lighten: -10 }};
  surface-1             : {{ colors.surface_container_lowest.default.hex }};
  border-col            : {{ colors.primary.default.hex }};
  app-width             : 45%;
  wallpaper-width       : 100%;
  rofi-radius           : 10px;
}
